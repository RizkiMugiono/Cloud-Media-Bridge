{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud-Media-Bridge task-scoped worker response",
  "description": "Worker protocol response including explicit fixture flag, integrity-checkable artifacts and status. Unlike model inference, offline fixture output never counts as verified AI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "simulation_only",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "running",
        "queued"
      ]
    },
    "simulation_only": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "media_type",
          "size_bytes",
          "sha256",
          "asset_ref"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 3
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "asset_ref": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "simulation_only": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
