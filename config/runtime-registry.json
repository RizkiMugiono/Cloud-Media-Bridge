{
  "schema_version": 1,
  "implementation_status": "read_only_candidates_no_deployment",
  "runtime_registry_policy": {
    "selection_priority": [
      "verified_exact_model_evidence",
      "verified_architecture_and_task",
      "verified_compatible_family",
      "otherwise_review_required"
    ],
    "eligible_sources": [
      "huggingface_official",
      "official_upstream",
      "reviewed_community",
      "model_author"
    ],
    "prefer_prebuilt_oci_when_equally_verified": true,
    "allow_vetted_installer_fallback": true,
    "never_execute_unverified_installer": true,
    "reject_remote_code_by_default": true,
    "never_assume_hub_metadata_is_executable": true,
    "never_copy_model_card_commands_into_shell": true,
    "no_matching_recipe_means": "runtime_unverified_not_model_unsupported",
    "require_new_human_approval_per_deployment": true,
    "cloud_execution_implemented": false
  },
