        "RUNPOD_API_KEY"
      ],
      "authentication": "user-owned API key",
      "api_base": "https://api.runpod.ai/v2/",
      "capabilities": {
        "discover": false,
        "plan": false,
        "deploy": false,
        "execute": false,
        "scale_to_zero": "provider_dependent"
      },
      "docs": "https://docs.runpod.io/serverless/endpoints/overview"
    },
    {
      "id": "runpod-pods",
