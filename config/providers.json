{
  "schema_version": 1,
  "purpose": "Public non-secret provider catalog. Account credentials stay in each user's local environment. Entries are capabilities and connection hints, not proof of live API integration.",
  "providers": [
    {
      "id": "modal",
      "name": "Modal",
      "kind": "serverless",
      "integration": "read_only",
      "driver": "modal_cli",
      "credential_env": [
        "MODAL_TOKEN_ID",
        "MODAL_TOKEN_SECRET"
      ],
      "authentication": "modal setup or workspace-scoped Modal environment credentials",
      "capabilities": {
        "discover": true,
        "plan": true,
        "deploy": false,
        "execute": false,
        "scale_to_zero": "supported_on_eligible_services"
      },
      "docs": "https://modal.com/docs/cli/latest/server"
    },
    {
      "id": "runpod-serverless",
      "name": "RunPod Serverless",
      "kind": "serverless",
      "integration": "planned",
      "driver": "runpod_queue_http",
