# OFFLINE FIXTURE TEST IMAGE ONLY. This image is NOT pinned/audited for GPU deployment.
# It intentionally contains no PyTorch, CUDA, model weights, AI inference libraries,
# provider tokens or production runtime dependencies.
FROM python:3.12-slim
WORKDIR /app
COPY workers/media_worker.py /app/media_worker.py
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CMB_BIND=127.0.0.1 \
    CMB_PORT=8000 \
    CMB_WORKER_MODE=fixture
USER 10001:10001
CMD ["python", "-I", "/app/media_worker.py"]
